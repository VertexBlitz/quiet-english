# Copy to .env.ru and fill in values on the Russian host.
# Never commit .env.ru or paste secrets into chat.

DOMAIN=ru.example.org
ACME_EMAIL=operator@example.org
APP_BASE_URL=https://ru.example.org
APP_REGION=ru
PORT=3000

POSTGRES_DB=quiet_english_ru
POSTGRES_USER=quiet_english
# Generate a hex-only value with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
# Generate with: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET

DB_SCHEMA=quiet_english_ru
REGISTRATION_REQUIRED_DB_SCHEMA=quiet_english_ru

REGISTRATION_ENABLED=false
REGISTRATION_LEGAL_APPROVED=false
REGISTRATION_DATABASE_ISOLATED=false
REGISTRATION_DATA_LOCALIZATION_APPROVED=false
REGISTRATION_OPERATOR_DETAILS_APPROVED=false
REGISTRATION_REGION_SERVICES_APPROVED=false
REGION_EXTERNAL_PROCESSORS_APPROVED=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

YOOKASSA_LIVE_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
