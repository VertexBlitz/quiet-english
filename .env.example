# Required for accounts and learning profiles
DATABASE_URL=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_BASE_URL=https://quiet-english-tutor.onrender.com
REGISTRATION_ENABLED=false
MINOR_SIGNUP_ENABLED=false
PGSSLMODE=

# Email verification and password reset (Resend HTTPS API)
RESEND_API_KEY=
EMAIL_FROM=

# Microsoft Azure Speech pronunciation assessment (optional)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Existing Cloudflare Workers AI integration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

PORT=3000
NODE_ENV=development
